{
    "name": "aClicker",
    "version": "1.0",
    "description": "a(uto)Clicker is a Chrome extension that automatically answers iClicker questions using reasoning LLMs. Based on ByeClicker by Vaibhav Sharma.",
    "author": "s",
    "manifest_version": 3,
    "action": {
        "default_title": "aClicker",
        "default_popup": "popup.html",
        "default_icon": "./assets/logo.png"
    },
    "icons": {
        "16": "./assets/logo-16.png",
        "32": "./assets/logo-32.png",
        "48": "./assets/logo-48.png",
        "128": "./assets/logo-128.png"
    },
    "permissions": [
        "tabs",
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "https://*.amazonaws.com/*",
        "https://student.iclicker.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://student.iclicker.com/*"
            ],
            "js": [
                "location-spoof.js"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://student.iclicker.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "location-spoof.js"
            ],
            "matches": [
                "https://student.iclicker.com/*"
            ]
        }
    ],
    "options_page": "options.html",
    "background": {
        "service_worker": "./background.js"
    }
}